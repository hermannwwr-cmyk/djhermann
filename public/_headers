# Response headers for Cloudflare (Pages / Workers static assets).
# Rules are additive: every matching block applies, so Cache-Control is only ever set by one block per path.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fingerprinted build output: cache for a year, never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The app shell and the service worker must always be fresh, or updates never reach players.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Not fingerprinted: revalidate (cheap 304s).
/worklets/*
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=86400
