// Cloudflare deploy config: the built game (dist/) served as static assets by a Worker.
// Step 2 adds a Worker script and a Durable Object per room to this same project.
// Build first (`npm run build`), then `npx wrangler deploy`.
{
  "name": "dj-hermann-game",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
