// Cloudflare deploy config: the Worker `djhermann` = the built game (dist/) as static assets
// + a small Worker script for /api/* + one Durable Object per multiplayer room.
// Cloudflare builds: build command `npm run build`, deploy command `npx wrangler deploy`.
// Local: `npm run build && npm run dev:worker` (http://localhost:8787).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "djhermann",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // only the API runs the Worker first; the game (and its SPA fallback) is served from assets
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects (the only kind the Workers free plan allows)
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
